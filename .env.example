# ── MCP Server ─────────────────────────────────────────────────
MCP_SERVER_NAME=contract-auth-service
MCP_SERVER_VERSION=1.0.0
PORT=8088

# ── Security ───────────────────────────────────────────────────
# Set a Bearer token to protect the /mcp endpoint. Leave empty for open access.
AUTH_BEARER_TOKEN=

CORS_ORIGIN=*

# ── Mock Service ──────────────────────────────────────────────
MOCK_SERVICE_PORT=3001
MOCK_SERVICE_URL=http://localhost:3001
