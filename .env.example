# ── MCP Server ─────────────────────────────────────────────────
MCP_SERVER_NAME=my-mcp-server
MCP_SERVER_VERSION=1.0.0
PORT=8088

# ── Security ───────────────────────────────────────────────────
# Set an API key to protect the /mcp endpoint. Leave empty for open access.
API_KEY=

# CORS origin — restrict in production (e.g. https://app.example.com)
CORS_ORIGIN=*

# ── Your Tool Config ──────────────────────────────────────────
# Add tool-specific environment variables below.
EXAMPLE_API_URL=https://api.example.com/v1
EXAMPLE_API_TOKEN=
